# Colab AI service (update this every Colab session)
INTERVIEWA_AI_SERVICE_URL=https://....

# Local services
INTERVIEWA_DATABASE_URL=sqlite+aiosqlite:///./interviewa.db
INTERVIEWA_REDIS_URL=redis://localhost:6379

# ChromaDB
INTERVIEWA_CHROMA_HOST=localhost
INTERVIEWA_CHROMA_PORT=8001

# Auth
# (JWT removed for local single-user mode)

# Groq fallback (if Colab goes down)
INTERVIEWA_GROQ_API_KEY=your_groq_key_here

# Langfuse (optional for now)
INTERVIEWA_LANGFUSE_PUBLIC_KEY=
INTERVIEWA_LANGFUSE_SECRET_KEY=
